# Public marketing configuration. Never put private credentials here.
NEXT_PUBLIC_APP_ORIGIN=https://app.crewzy.io
# Netlify supplies CONTEXT. Only its production build is indexable.
# Local development and deploy previews must leave this unset.
# CONTEXT=production
# CREWZY_SITE_BUILD_CONTEXT is derived by next.config.js, not a runtime override.
# Optional public ownership-verification tokens, supplied by the site owner.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Public GA4 measurement ID. Empty disables the tag and cookie prompt.
# Only production builds enable analytics, and only after visitor consent.
GA_MEASUREMENT_ID=
# Consent and analytics-cookie lifetime in days, integer 1–365; default 180.
ANALYTICS_CONSENT_DAYS=180
